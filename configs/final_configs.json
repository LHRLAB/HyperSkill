{
 "_meta": {
  "description": "Per-dataset HyperSkill settings of the main-table row. Each entry overrides the dataset's entry in hyperskill/configs/<modality>.yaml: library_run and train (library training on the 128 training questions), eval (evaluation on the test questions), seed (training order and LLM sampling seed).",
  "backbone_model": "google/gemini-2.5-flash-lite",
  "embedding_model": "google/gemini-embedding-2-preview",
  "knowledge_search_model": "google/gemini-3.8-flash",
  "api": {
   "base_url": "https://openrouter.ai/api/v1",
   "api_key_env": "OPENROUTER_API_KEY"
  },
  "data_dir": {
   "env": "HYPERSKILL_DATA_DIR",
   "default": "dataset"
  },
  "library_dir": "expr/<tag>_skill_library/<dataset>",
  "output_dir": "outputs/<tag>_hyperskill_<dataset>",
  "seed": 1,
  "env": {
   "HYPERSKILL_DISABLE_LLM_CACHE": "1",
   "HYPERSKILL_DISABLE_SEARCH_CACHE": "1"
  },
  "scorer": "hyperskill/grpo/rewards_cjk.py (main table); hyperskill/grpo/rewards.py is the official scorer used by the harness"
 },
